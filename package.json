{
  "name": "local-replica",
  "version": "0.0.5",
  "description": "Local-first replicas: paint the last known state on the first frame, reconcile with the server in the background",
  "keywords": [
    "local-first",
    "replica",
    "cache",
    "offline",
    "optimistic",
    "indexeddb",
    "zustand",
    "swr"
  ],
  "homepage": "https://github.com/lobehub/local-replica",
  "bugs": {
    "url": "https://github.com/lobehub/local-replica/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobehub/local-replica.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "default": "./es/index.js"
    },
    "./zustand": {
      "types": "./es/zustand/index.d.ts",
      "default": "./es/zustand/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./es/index.js",
  "types": "./es/index.d.ts",
  "files": [
    "es"
  ],
  "scripts": {
    "build": "tsdown",
    "docs:build": "lobedocs build",
    "docs:dev": "lobedocs dev",
    "prepare": "husky",
    "prepublishOnly": "bun run build",
    "release": "semantic-release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@lobehub/commitlint-config": "^2.1.7",
    "@lobehub/docs-kit": "^6.3.1",
    "@lobehub/semantic-release-config": "^2.1.7",
    "@lobehub/ui": "^6.9.0",
    "@react-router/dev": "^8.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-gitmoji-config": "^1.5.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "semantic-release": "^25.0.9",
    "swr": "^2.5.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
